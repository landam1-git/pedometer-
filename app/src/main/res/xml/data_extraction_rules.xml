<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and higher. The raw step-counter reading is only valid on this device and boot. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="sensor_state.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="sensor_state.xml" />
    </device-transfer>
</data-extraction-rules>
